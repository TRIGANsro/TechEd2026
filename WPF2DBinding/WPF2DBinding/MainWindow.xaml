<Window x:Class="WPF2DBinding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF2DBinding"
        xmlns:vm="clr-namespace:WPF2DBinding.ViewModels"
        xmlns:behaviors="clr-namespace:WPF2DBinding.Behaviors"
        xmlns:converters="clr-namespace:WPF2DBinding.Converters"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="WPF Image Annotator" Height="800" Width="1400"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    
    <Window.Resources>
        <converters:RectToCroppedImageConverter x:Key="RectToCroppedImageConverter"/>
        
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="35"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Vyberte obrázek:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding ImageFiles}" 
                          SelectedItem="{Binding SelectedImageFile}"
                          Height="30"
                          VerticalContentAlignment="Center"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Přidat zajímavost" 
                            Command="{Binding AddZajimavostCommand}"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="Uložit data" 
                            Command="{Binding SaveDataCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            IsEnabled="{Binding SelectedImageFile, Converter={x:Static converters:NullToBoolConverter.Instance}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel - DataGrid -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Seznam zajímavostí" 
                               FontWeight="Bold" FontSize="14" 
                               Margin="10" Background="#F0F0F0" Padding="5"/>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Zajimavosti}"
                              SelectedItem="{Binding SelectedZajimavost}"
                              Style="{StaticResource DataGridStyle}"
                              Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nadpis" Binding="{Binding Nadpis}" Width="*"/>
                            <DataGridTextColumn Header="Popis" Binding="{Binding Popis}" Width="*"/>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" 
                                                Command="{Binding DataContext.DeleteZajimavostCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Smazat"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Center panel - Main image with zoom and rectangles -->
            <Border Grid.Column="1" Background="#E0E0E0">
                <ScrollViewer x:Name="MainScrollViewer"
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ZoomBehavior ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"/>
                    </i:Interaction.Behaviors>
                    
                    <Grid x:Name="ImageContainer" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"
                          Background="Transparent">
                        <Image x:Name="MainImage"
                               Source="{Binding CurrentImage}" 
                               Stretch="None"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <Canvas x:Name="OverlayCanvas"
                                Width="{Binding ElementName=MainImage, Path=ActualWidth}"
                                Height="{Binding ElementName=MainImage, Path=ActualHeight}"
                                Background="Transparent">
                            <i:Interaction.Behaviors>
                                <behaviors:RectangleDragBehavior 
                                    Zajimavosti="{Binding Zajimavosti}"
                                    SelectedZajimavost="{Binding SelectedZajimavost, Mode=TwoWay}"
                                    ZoomLevel="{Binding ZoomLevel}"/>
                            </i:Interaction.Behaviors>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Right panel - Detail view -->
            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Detail výřezu" 
                               FontWeight="Bold" FontSize="14" 
                               Margin="10" Background="#F0F0F0" Padding="5"/>

                    <Viewbox Grid.Row="1" Margin="10" Stretch="Uniform">
                        <Image>
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource RectToCroppedImageConverter}">
                                    <Binding Path="CurrentImage"/>
                                    <Binding Path="SelectedZajimavost.Oblast"/>
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
